# Server Port
PORT=3000

# MongoDB Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/college_maintenance
MONGODB_URI=mongodb://127.0.0.1:27017/college_maintenance

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key

# Nodemailer / SMTP Email Notifications (Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
ADMIN_EMAIL=admin@example.com
TECHNICIAN_EMAIL=technician@example.com

# Google Gemini AI Chatbot
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
